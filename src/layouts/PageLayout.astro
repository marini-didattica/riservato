---
import Navbar from '@/components/Navbar.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { MAIN_SITE_URL, SITE_NAME, navLinks } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cn } from '@/utils/cn';

export interface Props {
  /** Page heading (h1) and basis for the document title. */
  title: string;
  /** Overrides the `<title>` text. Defaults to `${title} — ${SITE_NAME}`. */
  documentTitle?: string;
  /** Optional intro text under the heading (also used as the meta description). */
  description?: string;
  /** Optional small label above the heading. */
  eyebrow?: string;
  /** Extra classes for the content container. */
  class?: string;
}

const {
  title,
  documentTitle = `${title} — ${SITE_NAME}`,
  description,
  eyebrow,
  class: className,
} = Astro.props;
---

<BaseLayout title={documentTitle} description={description}>
  <Navbar slot="header" siteName={SITE_NAME} links={navLinks}>
    <ThemeToggle />
  </Navbar>

  <div class={cn('mx-auto w-full max-w-6xl px-6 py-12', className)}>
    <header class="mb-10">
      {eyebrow && (
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">{eyebrow}</p>
      )}
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      {description && <p class="mt-3 text-lg text-text-secondary">{description}</p>}
    </header>

    <slot />
  </div>

  <footer slot="footer" class="border-t border-border px-6 py-8 text-center text-sm text-text-secondary">
    <p>
      &copy; {new Date().getFullYear()} {SITE_NAME}.
      <span aria-hidden="true" class="mx-1">·</span>
      <a
        href={MAIN_SITE_URL}
        class="text-text-secondary no-underline transition-colors hover:text-accent"
      >
        Sito principale
      </a>
    </p>
  </footer>
</BaseLayout>
