---
import BackLink from '@/components/BackLink.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FileList from '@/components/FileList.astro';
import { AREA_URL } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
import { getDirectoryPages } from '@/lib/content-index';
import type { BreadcrumbItem } from '@/types';
import { withBase } from '@/utils/base';
import { encodePath } from '@/utils/paths';

export async function getStaticPaths() {
  return getDirectoryPages();
}

const { entries, dir, student, downloadFiles } = Astro.props;
const code = student.slug;
const ownerFirstName = student.owner.trim().split(/\s+/)[0] ?? student.owner;
const segments = dir.split('/').filter(Boolean);
const title = segments.length > 0 ? segments[segments.length - 1] : `Ciao ${ownerFirstName}!`;
const description =
  segments.length === 0
    ? `Materiale di ${student.owner}, assegnato al codice ${code}.`
    : `Contenuto della cartella ${title}.`;

function toZipSegment(value: string): string {
  return (
    value
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9._-]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 60) || 'materiale'
  );
}

const zipName = `${[student['owner-slug'], ...segments].map(toZipSegment).join('-')}.zip`;
const downloadLabel = segments.length === 0 ? 'Scarica tutto' : 'Scarica cartella';

const crumbs: BreadcrumbItem[] = [
  { label: 'Materiale riservato', href: AREA_URL },
  { label: student['owner-slug'], href: withBase(`/${code}/`) },
  ...segments.map((segment, index) => {
    const relative = segments.slice(0, index + 1).join('/');
    return {
      label: segment,
      href: withBase(`/${code}/${encodePath(relative)}/`),
    };
  }),
];

const parentPath = segments.slice(0, -1).join('/');
const parentHref =
  segments.length > 0
    ? withBase(`/${code}/${parentPath ? `${encodePath(parentPath)}/` : ''}`)
    : null;
---

<PageLayout
  title={title}
  eyebrow={segments.length === 0 ? 'Area riservata' : 'Materiale riservato'}
  description={description}
>
  <div class="mb-6 flex items-center gap-2">
    {parentHref && <BackLink href={parentHref} />}
    <Breadcrumbs items={crumbs} />
  </div>

  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-text-secondary">
      {entries.length === 0
        ? 'Cartella vuota'
        : `${entries.length} element${entries.length === 1 ? 'o' : 'i'}`}
    </p>
    <div class="flex flex-wrap items-center gap-2">
      {downloadFiles.length > 0 && (
        <button
          id="download-folder"
          type="button"
          data-zip-name={zipName}
          class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-semibold text-text transition-colors hover:bg-bg-secondary disabled:cursor-wait disabled:opacity-60"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <path d="m7 10 5 5 5-5"></path>
            <path d="M12 15V3"></path>
          </svg>
          <span data-download-label>{downloadLabel}</span>
        </button>
      )}
      <code class="rounded-md border border-border bg-bg-secondary px-2 py-1 text-xs text-text-secondary">
        {code}
      </code>
    </div>
  </div>

  <FileList entries={entries} />

  {downloadFiles.length > 0 && (
    <script
      type="application/json"
      id="download-folder-files"
      is:inline
      set:html={JSON.stringify(downloadFiles).replace(/</g, '\\u003c')}
    ></script>
  )}
</PageLayout>

<script>
  import { zipSync } from 'fflate';

  const button = document.getElementById('download-folder');
  const data = document.getElementById('download-folder-files');

  if (button instanceof HTMLButtonElement && data instanceof HTMLScriptElement) {
    const label = button.querySelector<HTMLElement>('[data-download-label]');
    const files = JSON.parse(data.textContent ?? '[]') as Array<{
      name: string;
      href: string;
      size: number;
    }>;

    button.addEventListener('click', async () => {
      if (files.length === 0) return;

      const originalLabel = label?.textContent ?? 'Scarica';
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      if (label) label.textContent = 'Preparazione…';

      try {
        const downloaded = await Promise.all(
          files.map(async (file) => {
            const response = await fetch(file.href);

            if (!response.ok) {
              throw new Error(`Impossibile scaricare ${file.name}`);
            }

            return [file.name, new Uint8Array(await response.arrayBuffer())] as const;
          }),
        );

        const zipData: Record<string, Uint8Array> = {};

        for (const [name, bytes] of downloaded) {
          zipData[name] = bytes;
        }

        const zipped = zipSync(zipData, { level: 0 });
        const blob = new Blob([zipped], { type: 'application/zip' });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement('a');

        anchor.href = url;
        anchor.download = button.dataset.zipName ?? 'materiale.zip';
        document.body.append(anchor);
        anchor.click();
        anchor.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      } catch (error) {
        console.error(error);
        if (label) label.textContent = 'Errore, riprova';
        setTimeout(() => {
          if (label) label.textContent = originalLabel;
        }, 2500);
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');

        if (label && label.textContent === 'Preparazione…') {
          label.textContent = originalLabel;
        }
      }
    });
  }
</script>
