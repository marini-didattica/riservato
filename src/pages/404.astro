---
import Button from '@/components/Button.astro';
import { AREA_URL } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Codice non trovato"
  eyebrow="Materiale riservato"
  description="Il codice non esiste oppure il materiale non è più disponibile."
>
  <div class="max-w-xl">
    <p class="text-text-secondary">
      Controlla di aver inserito il codice corretto, senza spazi e con tutti i caratteri. Se il
      problema continua, chiedi al docente.
    </p>
    <div class="mt-6">
      <Button href={AREA_URL}>Inserisci un altro codice</Button>
    </div>
  </div>
</PageLayout>
